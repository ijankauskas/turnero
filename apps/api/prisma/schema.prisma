generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserRole {
  ADMINISTRADOR
  ENCARGADO
  RECEPCION
  PROFESIONAL
}

enum RemunerationType {
  PERCENT
  FIXED
}

enum AppointmentStatus {
  RESERVADO
  CONFIRMADO
  ATENDIDO
  CANCELADO
  NO_ASISTIO
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationType {
  CREATED
  UPDATED
  CANCELLED
  REMINDER_24H
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ScheduleExceptionType {
  OFF
  CUSTOM
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

model Company {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  customDomain    String?   @unique @map("custom_domain")
  timezone        String    @default("America/Argentina/Buenos_Aires")
  currency        String    @default("ARS") @db.Char(3)
  locale          String    @default("es-AR")
  logoUrl         String?   @map("logo_url")
  primaryColor    String?   @map("primary_color")
  secondaryColor  String?   @map("secondary_color")
  contactEmail    String    @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  branches              Branch[]
  users                 User[]
  professionals         Professional[]
  professionalBranches  ProfessionalBranch[]
  workSchedules         WorkSchedule[]
  workScheduleExceptions WorkScheduleException[]
  services              Service[]
  professionalServices  ProfessionalService[]
  clients               Client[]
  appointments          Appointment[]
  payments              Payment[]
  notificationJobs      NotificationJob[]
  dailyNotes            DailyNote[]
  refreshTokens         RefreshToken[]

  @@map("companies")
}

model Branch {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  name      String
  address   String?
  phone     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  company               Company                  @relation(fields: [companyId], references: [id])
  users                 User[]
  professionalBranches  ProfessionalBranch[]
  workSchedules         WorkSchedule[]
  workScheduleExceptions WorkScheduleException[]
  appointments          Appointment[]
  dailyNotes            DailyNote[]

  @@index([companyId])
  @@map("branches")
}

model User {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  email          String    @db.Citext
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  role           UserRole
  branchId       String?   @map("branch_id")
  professionalId String?   @unique @map("professional_id")
  avatarUrl      String?   @map("avatar_url")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  company                 Company        @relation(fields: [companyId], references: [id])
  branch                  Branch?        @relation(fields: [branchId], references: [id])
  professional            Professional?  @relation("UserHasProfessional", fields: [professionalId], references: [id])
  professionalAccount     Professional?  @relation("ProfessionalBelongsToUser")
  createdAppointments     Appointment[]  @relation("AppointmentCreatedBy")
  cancelledAppointments   Appointment[]  @relation("AppointmentCancelledBy")
  createdPayments         Payment[]      @relation("PaymentCreatedBy")
  refreshTokens           RefreshToken[]

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@map("refresh_tokens")
}

model Professional {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  userId      String    @unique @map("user_id")
  displayName String    @map("display_name")
  title       String?
  color       String    @default("#7C6FF7")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company               Company                  @relation(fields: [companyId], references: [id])
  user                  User                     @relation("ProfessionalBelongsToUser", fields: [userId], references: [id])
  linkedUser            User?                    @relation("UserHasProfessional")
  branches              ProfessionalBranch[]
  schedules             WorkSchedule[]
  scheduleExceptions    WorkScheduleException[]
  services              ProfessionalService[]
  appointments          Appointment[]

  @@index([companyId])
  @@map("professionals")
}

model ProfessionalBranch {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  professionalId String   @map("professional_id")
  branchId       String   @map("branch_id")
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])

  @@unique([professionalId, branchId])
  @@index([companyId])
  @@map("professional_branches")
}

model WorkSchedule {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  professionalId String   @map("professional_id")
  branchId       String   @map("branch_id")
  weekday        Int      @db.SmallInt
  startTime      DateTime @map("start_time") @db.Time(0)
  endTime        DateTime @map("end_time") @db.Time(0)
  isOff          Boolean  @default(false) @map("is_off")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])

  @@index([companyId, professionalId, weekday])
  @@map("work_schedules")
}

model WorkScheduleException {
  id             String                 @id @default(uuid())
  companyId      String                 @map("company_id")
  professionalId String                 @map("professional_id")
  branchId       String?                @map("branch_id")
  date           DateTime               @db.Date
  type           ScheduleExceptionType
  startTime      DateTime?              @map("start_time") @db.Time(0)
  endTime        DateTime?              @map("end_time") @db.Time(0)
  note           String?
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])

  @@index([companyId, professionalId, date])
  @@map("work_schedule_exceptions")
}

model Service {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  name             String
  durationMinutes  Int       @map("duration_minutes")
  basePrice        Decimal   @map("base_price") @db.Decimal(12, 2)
  openPrice        Boolean   @default(false) @map("open_price")
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  company              Company               @relation(fields: [companyId], references: [id])
  professionalServices ProfessionalService[]
  appointments         Appointment[]

  @@index([companyId])
  @@map("services")
}

model ProfessionalService {
  id                 String            @id @default(uuid())
  companyId          String            @map("company_id")
  professionalId     String            @map("professional_id")
  serviceId          String            @map("service_id")
  price              Decimal           @db.Decimal(12, 2)
  remunerationType   RemunerationType  @map("remuneration_type")
  remunerationValue  Decimal           @map("remuneration_value") @db.Decimal(12, 2)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  @@unique([professionalId, serviceId])
  @@index([companyId])
  @@map("professional_services")
}

model Client {
  id                  String    @id @default(uuid())
  companyId           String    @map("company_id")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  phone               String
  email               String?
  notes               String?
  duplicateConfirmed  Boolean   @default(false) @map("duplicate_confirmed")
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  company      Company       @relation(fields: [companyId], references: [id])
  appointments Appointment[]

  @@index([companyId, phone])
  @@map("clients")
}

model Appointment {
  id                       String             @id @default(uuid())
  companyId                String             @map("company_id")
  branchId                 String             @map("branch_id")
  professionalId           String             @map("professional_id")
  clientId                 String             @map("client_id")
  serviceId                String             @map("service_id")
  startAt                  DateTime           @map("start_at")
  endAt                    DateTime           @map("end_at")
  durationMinutes          Int                @map("duration_minutes")
  price                    Decimal            @db.Decimal(12, 2)
  pricePending             Boolean            @default(false) @map("price_pending")
  serviceNameSnapshot      String             @map("service_name_snapshot")
  remunerationTypeSnapshot RemunerationType   @map("remuneration_type_snapshot")
  remunerationValueSnapshot Decimal           @map("remuneration_value_snapshot") @db.Decimal(12, 2)
  status                   AppointmentStatus  @default(RESERVADO)
  paid                     Boolean            @default(false)
  observations             String?
  internalNotes            String?            @map("internal_notes")
  cancelledAt              DateTime?          @map("cancelled_at")
  cancelledByUserId        String?            @map("cancelled_by_user_id")
  cancelReason             String?            @map("cancel_reason")
  createdByUserId          String             @map("created_by_user_id")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  createdBy    User         @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id])
  cancelledBy  User?        @relation("AppointmentCancelledBy", fields: [cancelledByUserId], references: [id])
  payments           Payment[]
  notificationJobs   NotificationJob[]

  @@index([companyId, professionalId, startAt])
  @@index([companyId, branchId, startAt])
  @@index([companyId, clientId])
  @@map("appointments")
}

model Payment {
  id              String         @id @default(uuid())
  companyId       String         @map("company_id")
  appointmentId   String         @map("appointment_id")
  amount          Decimal        @db.Decimal(12, 2)
  method          PaymentMethod?
  paidAt          DateTime       @map("paid_at")
  createdByUserId String         @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  createdBy   User        @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])

  @@index([companyId, appointmentId])
  @@map("payments")
}

model NotificationJob {
  id            String               @id @default(uuid())
  companyId     String               @map("company_id")
  appointmentId String               @map("appointment_id")
  channel       NotificationChannel
  type          NotificationType
  status        NotificationStatus   @default(PENDING)
  payload       Json
  sentAt        DateTime?            @map("sent_at")
  error         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([companyId, status])
  @@index([appointmentId])
  @@map("notification_jobs")
}

model DailyNote {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  branchId  String   @map("branch_id")
  date      DateTime @db.Date
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([branchId, date])
  @@index([companyId])
  @@map("daily_notes")
}
