# Copiar a .env en la raíz y a apps/api/.env (Prisma lee este último).

# PostgreSQL
POSTGRES_USER=turnero
POSTGRES_PASSWORD=turnero
POSTGRES_DB=turnero
POSTGRES_PORT=5432
DATABASE_URL=postgresql://turnero:turnero@localhost:5432/turnero?schema=public

# Redis (infra lista; el worker de email del MVP procesa jobs Postgres)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# JWT
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# SMTP (NTF-001 — no requerido para health)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
